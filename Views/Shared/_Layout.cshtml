@{
    var nombreVisible = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name ?? "Usuario";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EL CAMINO</title>

    <!-- Google Fonts: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS del Sistema y Paleta Oficial -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MS_EL_CAMINO.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navbar Oficial de 'El Camino' -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    EL <span>CAMINO</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2">
                        <li class="nav-item">
                            <a class="nav-link" href="/swagger" target="_blank" title="Documentación Swagger">
                                <span class="badge border border-primary text-primary" style="background-color: var(--color-surface); font-size: 0.75rem;">
                                    Swagger API
                                </span>
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="rounded-circle d-inline-flex justify-content-center align-items-center text-white" 
                                          style="width:28px; height:28px; font-size:12px; font-weight:700; background: linear-gradient(135deg, var(--color-primary), var(--color-gold));">
                                        @(nombreVisible.Length > 0 ? nombreVisible.Substring(0, 1).ToUpper() : "U")
                                    </span>
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" style="background-color: var(--color-card); border: 1px solid var(--color-border);">
                                    <li><a class="dropdown-item text-white" asp-controller="Login" asp-action="Profile">Mi perfil</a></li>
                                    <li><hr class="dropdown-divider" style="border-color: var(--color-border);"></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                    <li><hr class="dropdown-divider" style="border-color: var(--color-border);"></li>
                                    <li>
                                        <form asp-controller="Login" asp-action="Logout" method="post" class="m-0" data-confirm-logout>
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">Cerrar Sesión</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary px-3" asp-controller="Login" asp-action="Index">
                                    Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido Principal -->
    <div class="flex-grow-1 d-flex flex-column">
        <main role="main" class="flex-grow-1 d-flex flex-column">
            @RenderBody()
        </main>
    </div>

    @if (TempData["NotificationMessage"] is string notificationMessage)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3 notification-container" aria-live="polite" aria-atomic="true">
            <div class="toast app-toast text-bg-success border-0" role="status" data-bs-delay="5000">
                <div class="toast-body d-flex align-items-center justify-content-between gap-3">
                    <span>@notificationMessage</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="logoutConfirmationModal" tabindex="-1" aria-labelledby="logoutConfirmationTitle" aria-describedby="logoutConfirmationDescription" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content logout-modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="logoutConfirmationTitle">Cerrar sesión</h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cancelar"></button>
                </div>
                <div class="modal-body" id="logoutConfirmationDescription">
                    ¿Estás seguro de que deseas cerrar tu sesión?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Seguir aquí</button>
                    <button type="button" class="btn btn-danger" id="confirmLogoutButton">Cerrar sesión</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Oficial -->
    <footer class="footer text-center">
        <div class="container">
            EL CAMINO &bull; Tu evolución tecnológica &copy; 2026
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

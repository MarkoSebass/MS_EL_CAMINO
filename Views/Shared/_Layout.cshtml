@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var loginUrl = "/Identity/Account/Login";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050505" />
    <title>EL CAMINO</title>
    <link rel="icon" type="image/png" href="~/images/el-camino-logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/el-camino-logo.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <header class="site-header" id="page-top">
        <nav class="journey-nav" aria-label="Navegación principal">
            <div class="journey-nav__inner">
                <a class="brand-lockup" asp-controller="Home" asp-action="Index" aria-label="EL CAMINO, inicio">
                    <span class="brand-mark" aria-hidden="true">
                        <img src="~/images/el-camino-logo.png" alt="" />
                    </span>
                    <span class="brand-copy">
                        <span class="brand-name">EL CAMINO</span>
                        <span class="brand-meta">KM-001 <i aria-hidden="true"></i> EN RUTA</span>
                    </span>
                </a>

                <button class="nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation"
                        aria-controls="main-navigation" aria-expanded="false" aria-label="Abrir navegación">
                    <span></span><span></span>
                </button>

                <div class="journey-nav__content collapse" id="main-navigation">
                    <div class="road-progress" aria-hidden="true"><span></span></div>
                    <ul class="module-nav">
                        <li>
                            <a class="module-link @(currentAction == "Index" ? "is-current" : "")" asp-controller="Home" asp-action="Index" aria-current="@(currentAction == "Index" ? "page" : null)">
                                Inicio
                            </a>
                        </li>
                        <li>
                            @if (isAuthenticated)
                            {
                                <a class="module-link" href="#catalogo">Catálogo Tecnológico</a>
                            }
                            else
                            {
                                <button class="module-link module-link--locked" type="button" data-bs-toggle="modal" data-bs-target="#access-modal" data-module="Catálogo Tecnológico">
                                    Catálogo Tecnológico<span class="lock-mark" aria-label="Bloqueado">↗</span>
                                </button>
                            }
                        </li>
                        <li>
                            @if (isAuthenticated)
                            {
                                <a class="module-link" href="#setup">Mi Setup PC</a>
                            }
                            else
                            {
                                <button class="module-link module-link--locked" type="button" data-bs-toggle="modal" data-bs-target="#access-modal" data-module="Mi Setup PC">
                                    Mi Setup PC<span class="lock-mark" aria-label="Bloqueado">↗</span>
                                </button>
                            }
                        </li>
                        <li>
                            @if (isAuthenticated)
                            {
                                <a class="module-link" href="#biblioteca">Biblioteca de Juegos</a>
                            }
                            else
                            {
                                <button class="module-link module-link--locked" type="button" data-bs-toggle="modal" data-bs-target="#access-modal" data-module="Biblioteca de Juegos">
                                    Biblioteca de Juegos<span class="lock-mark" aria-label="Bloqueado">↗</span>
                                </button>
                            }
                        </li>
                        <li>
                            <a class="module-link @(currentAction == "SobreElCreador" ? "is-current" : "")"
                               asp-controller="Home" asp-action="SobreElCreador"
                               aria-current="@(currentAction == "SobreElCreador" ? "page" : null)">Sobre el Creador</a>
                        </li>
                    </ul>

                    @if (isAuthenticated)
                    {
                        <a class="account-action" href="/Identity/Account/Manage">
                            <span class="account-action__dot" aria-hidden="true"></span>Mi Perfil
                        </a>
                    }
                    else
                    {
                        <a class="account-action" href="@loginUrl">
                            Iniciar Sesión <span aria-hidden="true">↗</span>
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="page-content" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__main">
            <section class="footer-brand" aria-label="Acerca de EL CAMINO">
                <a class="brand-lockup" asp-controller="Home" asp-action="Index" aria-label="EL CAMINO, volver al inicio">
                    <span class="brand-mark" aria-hidden="true">
                        <img src="~/images/el-camino-logo.png" alt="" />
                    </span>
                    <span class="brand-copy">
                        <span class="brand-name">EL CAMINO</span>
                        <span class="brand-meta">BITÁCORA TECNOLÓGICA PERSONAL</span>
                    </span>
                </a>
                <p>Cada adquisición cuenta una parte de mi historia tecnológica.</p>
                <span class="footer-philosophy">No es lo que tienes. Es el camino.</span>
                <div class="footer-build-status">
                    <span class="footer-build-status__light" aria-hidden="true"></span>
                    PROYECTO PERSONAL · EN EVOLUCIÓN
                </div>
            </section>

            <nav class="footer-column footer-nav" aria-label="Enlaces del proyecto">
                <span class="footer-heading">DESCUBRE</span>
                <a asp-controller="Home" asp-action="Index">Inicio <span aria-hidden="true">↗</span></a>
                <a asp-controller="Home" asp-action="SobreElCreador">Sobre el creador <span aria-hidden="true">↗</span></a>
                <a href="@Url.Action("Index", "Home")#filosofia">La filosofía <span aria-hidden="true">↗</span></a>
                <a href="@Url.Action("Index", "Home")#modulos">El mapa del camino <span aria-hidden="true">↗</span></a>
            </nav>

            <div class="footer-column footer-destinations">
                <span class="footer-heading">PARADAS</span>
                @if (isAuthenticated)
                {
                    <a href="@Url.Action("Index", "Home")#catalogo">Catálogo tecnológico <span aria-hidden="true">↗</span></a>
                    <a href="@Url.Action("Index", "Home")#setup">Mi Setup PC <span aria-hidden="true">↗</span></a>
                    <a href="@Url.Action("Index", "Home")#biblioteca">Biblioteca de juegos <span aria-hidden="true">↗</span></a>
                }
                else
                {
                    <button class="footer-locked-link" type="button" data-bs-toggle="modal" data-bs-target="#access-modal" data-module="Catálogo Tecnológico">Catálogo tecnológico <span aria-hidden="true">↗</span></button>
                    <button class="footer-locked-link" type="button" data-bs-toggle="modal" data-bs-target="#access-modal" data-module="Mi Setup PC">Mi Setup PC <span aria-hidden="true">↗</span></button>
                    <button class="footer-locked-link" type="button" data-bs-toggle="modal" data-bs-target="#access-modal" data-module="Biblioteca de Juegos">Biblioteca de juegos <span aria-hidden="true">↗</span></button>
                }
                @if (isAuthenticated)
                {
                    <span class="footer-destinations-note">Tu recorrido personal, siempre en evolución.</span>
                }
                else
                {
                    <span class="footer-destinations-note">Áreas personales disponibles al iniciar sesión.</span>
                }
            </div>

            <div class="footer-column footer-connect">
                <span class="footer-heading">CONECTA CONMIGO</span>
                <span class="footer-contact-name">Marko Sebastian<br />Orihuela Carrasco</span>
                <span class="footer-contact-role">Creador y autor de EL CAMINO</span>
                <div class="footer-socials" aria-label="Redes sociales">
                    <a href="https://www.instagram.com/marko_sebass/" target="_blank" rel="noopener noreferrer" aria-label="Instagram de Marko Sebastian (abre en una pestaña nueva)">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <rect x="3" y="3" width="18" height="18" rx="5" />
                            <circle cx="12" cy="12" r="4" />
                            <circle class="social-icon__dot" cx="17.5" cy="6.8" r="1" />
                        </svg>
                        <span>Instagram</span><span class="social-external" aria-hidden="true">↗</span>
                    </a>
                    <a href="https://www.linkedin.com/in/msorihuelac" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Marko Sebastian (abre en una pestaña nueva)">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 9v10M5 5.5v.1M10 19v-6a4 4 0 0 1 8 0v6M10 9v10" />
                        </svg>
                        <span>LinkedIn</span><span class="social-external" aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="site-footer__bottom">
            <span class="footer-copyright">© @DateTime.Now.Year EL CAMINO <span class="footer-separator">/</span> Creado por Marko Sebastian Orihuela Carrasco.</span>
            <span class="footer-route__status"><i aria-hidden="true"></i> CADA PASO CUENTA</span>
            <a class="footer-back-top" href="#page-top">Volver al inicio <span aria-hidden="true">↑</span></a>
        </div>
    </footer>

    <div class="modal fade access-modal" id="access-modal" tabindex="-1" aria-labelledby="access-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <button class="modal-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar">×</button>
                <span class="modal-kicker"><span></span> ACCESO RESTRINGIDO</span>
                <h2 id="access-modal-title">Un tramo más adelante.</h2>
                <p class="access-modal__message">Módulo bloqueado.<br />Debes iniciar sesión para acceder a esta sección.</p>
                <p class="access-modal__module" id="access-modal-module"></p>
                <a class="button-primary access-modal__action" href="@loginUrl">Iniciar Sesión <span aria-hidden="true">↗</span></a>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

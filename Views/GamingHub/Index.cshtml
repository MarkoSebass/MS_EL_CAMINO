@using System.Globalization
@model MS_EL_CAMINO.ViewModels.GamingHubViewModel
@{
    ViewData["Title"] = "Gaming Hub";
}

<div class="gaming-hub container-xxl">
    <header class="gaming-hero">
        <div class="gaming-hero__texture" aria-hidden="true"></div>
        <div class="gaming-hero__copy">
            <span class="gaming-eyebrow"><i class="bi bi-controller" aria-hidden="true"></i> EL CAMINO / GAMING HUB</span>
            <h1>Mi historia<br />en <span>modo juego.</span></h1>
            <p class="gaming-hero__lead">Mi recorrido a través de los videojuegos.</p>
            <p class="gaming-hero__description">Un espacio donde se registran experiencias, aventuras y recuerdos construidos a través de los videojuegos.</p>
            <a class="gaming-hero__action" href="#gaming-timeline">Explorar mi recorrido <i class="bi bi-arrow-down-right" aria-hidden="true"></i></a>
        </div>
        <div class="gaming-hero__emblem" aria-hidden="true">
            <span class="gaming-hero__emblem-ring"></span>
            <i class="bi bi-controller"></i>
            <span class="gaming-hero__coordinates">PLAYER / 01</span>
        </div>
        <div class="gaming-hero__profile">
            <span class="gaming-hero__profile-icon"><i class="bi bi-person-bounding-box" aria-hidden="true"></i></span>
            <span><small>PERFIL GAMER</small><strong>Mi camino, a mi ritmo.</strong></span>
        </div>
    </header>

    <nav class="gaming-anchor-nav nav nav-pills flex-nowrap" aria-label="Secciones del Gaming Hub">
        <a class="nav-link" href="#gaming-now"><i class="bi bi-play-circle" aria-hidden="true"></i> Ahora</a>
        <a class="nav-link" href="#gaming-timeline"><i class="bi bi-signpost-split" aria-hidden="true"></i> Mi timeline</a>
        <a class="nav-link" href="#gaming-hall"><i class="bi bi-award" aria-hidden="true"></i> Hall of Fame</a>
        <a class="nav-link" href="#gaming-future"><i class="bi bi-stars" aria-hidden="true"></i> Próximas aventuras</a>
    </nav>

    <section class="gaming-summary row row-cols-2 row-cols-lg-4 g-3" aria-label="Resumen gamer">
        <div class="col"><article class="gaming-summary-card card gaming-summary-card--total">
            <span class="gaming-summary-card__icon"><i class="bi bi-controller" aria-hidden="true"></i></span>
            <span class="gaming-summary-card__label">JUEGOS TOTALES</span>
            <strong>@Model.TotalJuegos</strong>
            <span class="gaming-summary-card__detail">parte de mi recorrido</span>
        </article></div>
        <div class="col"><article class="gaming-summary-card card gaming-summary-card--completed">
            <span class="gaming-summary-card__icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
            <span class="gaming-summary-card__label">COMPLETADOS</span>
            <strong>@Model.TotalCompletados</strong>
            <span class="gaming-summary-card__detail">aventuras concluidas</span>
        </article></div>
        <div class="col"><article class="gaming-summary-card card gaming-summary-card--playing">
            <span class="gaming-summary-card__icon"><i class="bi bi-play-circle" aria-hidden="true"></i></span>
            <span class="gaming-summary-card__label">JUGANDO</span>
            <strong>@Model.TotalJugando</strong>
            <span class="gaming-summary-card__detail">en curso ahora</span>
        </article></div>
        <div class="col"><article class="gaming-summary-card card gaming-summary-card--pending">
            <span class="gaming-summary-card__icon"><i class="bi bi-bookmark-star" aria-hidden="true"></i></span>
            <span class="gaming-summary-card__label">PENDIENTES</span>
            <strong>@Model.TotalPendientes</strong>
            <span class="gaming-summary-card__detail">historias por comenzar</span>
        </article></div>
    </section>

    <section class="gaming-feature-row row g-3" id="gaming-now">
        <div class="col-12 col-xl-7"><article class="gaming-panel card gaming-now">
            <div class="gaming-section-heading">
                <div>
                    <span class="gaming-eyebrow">EN ESTE MOMENTO</span>
                    <h2>Actividad actual</h2>
                </div>
                <span class="gaming-live-badge"><i aria-hidden="true"></i> MI PARTIDA</span>
            </div>
            @if (Model.JuegoActual is { } juegoActual)
            {
                <div class="gaming-now__content">
                    <div class="gaming-now__cover">
                        @if (!string.IsNullOrWhiteSpace(juegoActual.ImagenUrl))
                        {
                            <img src="@juegoActual.ImagenUrl" alt="Portada de @juegoActual.Titulo" />
                        }
                        else
                        {
                            <i class="bi bi-controller" aria-hidden="true"></i>
                        }
                        <span>JUGANDO</span>
                    </div>
                    <div class="gaming-now__details">
                        <span class="gaming-game-platform">@juegoActual.Plataforma</span>
                        <h3>@juegoActual.Titulo</h3>
                        <p class="gaming-now__genre">@(string.IsNullOrWhiteSpace(juegoActual.Genero) ? "Una nueva aventura" : juegoActual.Genero)</p>
                        <div class="gaming-progress">
                            <div class="gaming-progress__heading"><span>Capítulo actual</span><span>Por registrar</span></div>
                            <div class="gaming-progress__track" aria-label="Avance por registrar"></div>
                        </div>
                        <div class="gaming-now__objective"><i class="bi bi-compass" aria-hidden="true"></i><span><small>OBJETIVO ACTUAL</small><strong>La próxima misión está por escribirse.</strong></span></div>
                    </div>
                </div>
            }
            else
            {
                <div class="gaming-now__empty">
                    <span><i class="bi bi-moon-stars" aria-hidden="true"></i></span>
                    <h3>Tu próxima sesión aún no tiene protagonista.</h3>
                    <p>Cuando marques un juego como “Jugando”, aparecerá aquí para continuar tu historia.</p>
                    <a href="#gaming-timeline">Explorar mi recorrido <i class="bi bi-arrow-down-right" aria-hidden="true"></i></a>
                </div>
            }
        </article></div>

        <div class="col-12 col-xl-5"><aside class="gaming-panel card gaming-profile">
            <div class="gaming-section-heading">
                <div>
                    <span class="gaming-eyebrow">QUIÉN SOY CUANDO JUEGO</span>
                    <h2>Perfil gamer</h2>
                </div>
                <i class="bi bi-person-vcard gaming-profile__heading-icon" aria-hidden="true"></i>
            </div>
            <dl class="gaming-profile__list">
                <div><dt>Jugador desde</dt><dd>Por definir</dd></div>
                <div><dt>Plataforma favorita</dt><dd>Por definir</dd></div>
                <div><dt>Género favorito</dt><dd>Por definir</dd></div>
                <div><dt>Saga favorita</dt><dd>Por definir</dd></div>
                <div><dt>Juego favorito</dt><dd>Por definir</dd></div>
                <div><dt>Universo favorito</dt><dd>Por definir</dd></div>
            </dl>
            <p class="gaming-profile__note"><i class="bi bi-info-circle" aria-hidden="true"></i> Este perfil se podrá personalizar cuando registremos tus preferencias.</p>
        </aside></div>
    </section>

    <section class="gaming-section" id="gaming-timeline">
        <div class="gaming-section-heading gaming-section-heading--large">
            <div>
                <span class="gaming-eyebrow">CADA AÑO, UNA NUEVA PARTIDA</span>
                <h2>Mi timeline gamer</h2>
                <p>Los juegos que se han sumado a mi recorrido, etapa por etapa.</p>
            </div>
            <span class="gaming-section-index">01 / EL RECORRIDO</span>
        </div>
        <div class="gaming-timeline">
            @if (Model.Timeline.Count == 0)
            {
                <div class="gaming-timeline__empty">
                    <i class="bi bi-signpost" aria-hidden="true"></i>
                    <p>Tu historia está lista para comenzar. Los juegos registrados aparecerán aquí.</p>
                </div>
            }
            else
            {
                @foreach (var etapa in Model.Timeline)
                {
                    <article class="gaming-timeline__year">
                        <div class="gaming-timeline__marker"><span></span></div>
                        <div class="gaming-timeline__year-label">
                            <strong>@(etapa.Anio?.ToString(CultureInfo.InvariantCulture) ?? "SIN FECHA")</strong>
                            <span>@(etapa.Anio.HasValue ? "AÑO DE REGISTRO" : "FECHA POR DEFINIR")</span>
                        </div>
                        <div class="gaming-timeline__games">
                            @foreach (var juego in etapa.Juegos)
                            {
                                <div class="gaming-timeline-game">
                                    <span class="gaming-timeline-game__icon"><i class="bi bi-controller" aria-hidden="true"></i></span>
                                    <span><strong>@juego.Titulo</strong><small>@juego.Plataforma · @juego.Estado</small></span>
                                </div>
                            }
                        </div>
                    </article>
                }
            }
        </div>
        <p class="gaming-section-footnote"><i class="bi bi-info-circle" aria-hidden="true"></i> La fecha disponible corresponde al registro o compra, no necesariamente al año en que jugaste.</p>
    </section>

    <section class="gaming-feature-row gaming-feature-row--lower row g-3" id="gaming-hall">
        <div class="col-12 col-lg-6"><article class="gaming-panel card gaming-hall">
            <div class="gaming-section-heading">
                <div>
                    <span class="gaming-eyebrow">MIS FAVORITOS, MIS REGLAS</span>
                    <h2>Hall of Fame</h2>
                </div>
                <span class="gaming-hall__personal"><i class="bi bi-heart" aria-hidden="true"></i> TOP PERSONAL</span>
            </div>
            <div class="gaming-hall__list">
                @for (var puesto = 1; puesto <= 5; puesto++)
                {
                    var medalla = puesto switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => "🏅" };
                    <div class="gaming-hall__entry">
                        <span class="gaming-hall__medal" aria-hidden="true">@medalla</span>
                        <span class="gaming-hall__rank">0@puesto</span>
                        <span class="gaming-hall__game">@(puesto == 1 ? "Juego favorito" : $"{puesto}º lugar")</span>
                        <span class="gaming-hall__placeholder">Por elegir</span>
                    </div>
                }
            </div>
            <p class="gaming-panel-note">Una selección personal: estos lugares no se calculan, los eliges tú.</p>
        </article></div>

        <div class="col-12 col-lg-6"><article class="gaming-panel card gaming-milestones">
            <div class="gaming-section-heading">
                <div>
                    <span class="gaming-eyebrow">MOMENTOS QUE RECUERDO</span>
                    <h2>Logros personales</h2>
                </div>
                <i class="bi bi-stars gaming-profile__heading-icon" aria-hidden="true"></i>
            </div>
            <div class="gaming-milestones__list">
                <div><i class="bi bi-flag" aria-hidden="true"></i><span><strong>Primer juego completado</strong><small>Un recuerdo por registrar</small></span></div>
                <div><i class="bi bi-compass" aria-hidden="true"></i><span><strong>Primer RPG terminado</strong><small>Un recuerdo por registrar</small></span></div>
                <div><i class="bi bi-map" aria-hidden="true"></i><span><strong>Primer mundo abierto</strong><small>Un recuerdo por registrar</small></span></div>
                <div><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span><strong>Juego más rejugado</strong><small>Un recuerdo por registrar</small></span></div>
                <div><i class="bi bi-trophy" aria-hidden="true"></i><span><strong>Primer platino conseguido</strong><small>Un recuerdo por registrar</small></span></div>
            </div>
            <p class="gaming-panel-note">Hitos personales, no trofeos conectados a una plataforma.</p>
        </article></div>
    </section>

    <section class="gaming-section gaming-universes" id="gaming-universes">
        <div class="gaming-section-heading gaming-section-heading--large">
            <div>
                <span class="gaming-eyebrow">LUGARES A LOS QUE SIEMPRE VUELVO</span>
                <h2>Universos favoritos</h2>
                <p>Mundos que dejaron una huella más allá de los créditos.</p>
            </div>
        </div>
        <div class="gaming-universe-grid row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3">
            <div class="col"><article class="gaming-universe-card gaming-universe-card--cyberpunk"><span>01 / NEÓN</span><h3>Cyberpunk</h3><i class="bi bi-buildings" aria-hidden="true"></i></article></div>
            <div class="col"><article class="gaming-universe-card gaming-universe-card--witcher"><span>02 / FANTASÍA</span><h3>The Witcher</h3><i class="bi bi-moon-stars" aria-hidden="true"></i></article></div>
            <div class="col"><article class="gaming-universe-card gaming-universe-card--god"><span>03 / MITO</span><h3>God of War</h3><i class="bi bi-lightning-charge" aria-hidden="true"></i></article></div>
            <div class="col"><article class="gaming-universe-card gaming-universe-card--reddead"><span>04 / FRONTERA</span><h3>Red Dead<br />Redemption</h3><i class="bi bi-sunset" aria-hidden="true"></i></article></div>
            <div class="col"><article class="gaming-universe-card gaming-universe-card--elder"><span>05 / AVENTURA</span><h3>The Elder<br />Scrolls</h3><i class="bi bi-mountains" aria-hidden="true"></i></article></div>
        </div>
    </section>

    <section class="gaming-section gaming-upcoming" id="gaming-future">
        <div class="gaming-section-heading gaming-section-heading--large">
            <div>
                <span class="gaming-eyebrow">EL PRÓXIMO CAPÍTULO TODAVÍA NO ESCRITO</span>
                <h2>Próximas aventuras</h2>
                <p>Historias que espero vivir cuando llegue el momento.</p>
            </div>
            <span class="gaming-upcoming__stamp"><i class="bi bi-stars" aria-hidden="true"></i> EN EL HORIZONTE</span>
        </div>
        <div class="gaming-upcoming__grid row row-cols-2 row-cols-lg-4 g-3">
            <div class="col"><article><span>01 / MUNDO ABIERTO</span><i class="bi bi-eye" aria-hidden="true"></i><h3>Grand Theft Auto VI</h3><p>Una nueva ciudad por descubrir.</p></article></div>
            <div class="col"><article><span>02 / FANTASÍA</span><i class="bi bi-moon-stars" aria-hidden="true"></i><h3>The Witcher 4</h3><p>Un nuevo viaje por el Continente.</p></article></div>
            <div class="col"><article><span>03 / AVENTURA</span><i class="bi bi-signpost-2" aria-hidden="true"></i><h3>Death Stranding 2</h3><p>Una conexión que continúa.</p></article></div>
            <div class="col"><article><span>04 / EXPLORACIÓN</span><i class="bi bi-wind" aria-hidden="true"></i><h3>Ghost of Yōtei</h3><p>Una historia en tierras lejanas.</p></article></div>
        </div>
    </section>

</div>

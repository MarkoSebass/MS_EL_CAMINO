@{
    ViewData["Title"] = "Dashboard";

    var nombreUsuario = User.Identity?.Name ?? "Usuario";

    var correoUsuario = User.Claims
        .FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?
        .Value ?? "";
}

<div class="container-fluid py-4">

    <div class="card-custom mb-4">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="badge bg-primary mb-3">
                    EL CAMINO
                </span>

                <h1 class="display-6 fw-bold mb-2">
                    Bienvenido,
                    <span class="text-gold">
                        @nombreUsuario
                    </span>
                </h1>

                <p class="text-muted-custom mb-3">
                    Gestiona tus dispositivos, componentes, metas y analiza tu evolución tecnológica desde un único lugar.
                </p>

                @if (!string.IsNullOrEmpty(correoUsuario))
                {
                    <span class="badge bg-dark border border-secondary">
                        @correoUsuario
                    </span>
                }

            </div>

            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                <form asp-controller="Login"
                      asp-action="Logout"
                        method="post"
                        data-confirm-logout>

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger">

                        Cerrar Sesión

                    </button>

                </form>

            </div>

        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="stat-card">

                <div class="stat-title">
                    Inversión Total
                </div>

                <div class="stat-value">
                    S/ 0.00
                </div>

                <small class="text-muted-custom">
                    Valor acumulado del setup
                </small>

            </div>

        </div>

        <div class="col-xl-3 col-md-6">

            <div class="stat-card">

                <div class="stat-title">
                    Dispositivos
                </div>

                <div class="stat-value">
                    0
                </div>

                <small class="text-muted-custom">
                    Equipos registrados
                </small>

            </div>

        </div>

        <div class="col-xl-3 col-md-6">

            <div class="stat-card">

                <div class="stat-title">
                    Componentes PC
                </div>

                <div class="stat-value">
                    0
                </div>

                <small class="text-muted-custom">
                    Hardware registrado
                </small>

            </div>

        </div>

        <div class="col-xl-3 col-md-6">

            <div class="stat-card">

                <div class="stat-title">
                    Metas
                </div>

                <div class="stat-value">
                    0
                </div>

                <small class="text-muted-custom">
                    Objetivos pendientes
                </small>

            </div>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card-custom h-100">

                <h4 class="mb-4">
                    Mi Historia Tecnológica
                </h4>

                <p class="text-muted-custom">
                    EL CAMINO es una plataforma diseñada para registrar cada adquisición tecnológica,
                    visualizar el crecimiento de tu setup y mantener un historial completo de tu evolución.
                </p>

                <hr>

                <div class="row text-center mt-4">

                    <div class="col-md-4">

                        <h2 class="text-gold">
                            0
                        </h2>

                        <p class="text-muted-custom">
                            Dispositivos
                        </p>

                    </div>

                    <div class="col-md-4">

                        <h2 class="text-gold">
                            0
                        </h2>

                        <p class="text-muted-custom">
                            Componentes
                        </p>

                    </div>

                    <div class="col-md-4">

                        <h2 class="text-gold">
                            0
                        </h2>

                        <p class="text-muted-custom">
                            Metas
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card-custom mb-4">

                <h5 class="mb-3">
                    Próxima Meta
                </h5>

                <h3 class="text-gold">
                    Sin registrar
                </h3>

                <p class="text-muted-custom">
                    Agrega tus metas tecnológicas para realizar seguimiento.
                </p>

            </div>

            <div class="card-custom">

                <h5 class="mb-3">
                    Estado del Sistema
                </h5>

                <ul class="list-group list-group-flush">

                    <li class="list-group-item bg-transparent text-white border-secondary">
                        ✅ Autenticación activa
                    </li>

                    <li class="list-group-item bg-transparent text-white border-secondary">
                        ✅ PostgreSQL conectado
                    </li>

                    <li class="list-group-item bg-transparent text-white border-secondary">
                        ✅ Login configurado
                    </li>

                    <li class="list-group-item bg-transparent text-white border-secondary">
                        🚀 Dashboard operativo
                    </li>

                </ul>

            </div>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-12">

            <div class="card-custom">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <div>

                        <h5 class="mb-1">
                            Swagger API
                        </h5>

                        <p class="text-muted-custom mb-0">
                            Administra y prueba los endpoints del sistema directamente desde Swagger.
                        </p>

                    </div>

                    /swagger

                        Abrir Swagger

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
@using System.Globalization
@model MS_EL_CAMINO.ViewModels.CatalogoViewModel
@{
    ViewData["Title"] = "Catálogo tecnológico";
    var esAdmin = Model.EsAdministrador;
    var dispositivosFuturos = Model.FuturasColecciones;
}

<div class="catalog-page" data-initial-section="@Model.SeccionInicial">
    <header class="catalog-hero">
        <div class="catalog-hero__copy">
            <span class="catalog-kicker"><i class="bi bi-compass-fill" aria-hidden="true"></i> COLECCIÓN PERSONAL</span>
            <h1>Lo que forma<br />parte del <span>camino.</span></h1>
            <p>Dispositivos que acompañan tu historia, y los que todavía esperan su momento.</p>
        </div>
        <div class="catalog-hero__mark" aria-hidden="true">
            <span class="catalog-hero__orbit"></span>
            <i class="bi bi-box-seam"></i>
            <span class="catalog-hero__coordinates">EL CAMINO · 001</span>
        </div>
    </header>

    <nav class="catalog-section-nav" aria-label="Secciones del catálogo" role="tablist">
        <button class="catalog-section-nav__link" id="catalog-tab-current" type="button"
                role="tab" aria-selected="true" aria-controls="my-collection" data-catalog-section="my-collection">
            <span class="catalog-section-nav__icon"><i class="bi bi-collection" aria-hidden="true"></i></span>
            <span class="catalog-section-nav__copy">
                <strong>Mi colección</strong>
                <span>Lo que ya tienes</span>
            </span>
            <span class="catalog-section-nav__count" id="catalog-tab-count">@Model.Productos.Count</span>
        </button>
        <button class="catalog-section-nav__link" id="catalog-tab-future" type="button"
                role="tab" aria-selected="false" aria-controls="future-collections" data-catalog-section="future-collections">
            <span class="catalog-section-nav__icon catalog-section-nav__icon--future"><i class="bi bi-stars" aria-hidden="true"></i></span>
            <span class="catalog-section-nav__copy">
                <strong>Futuras colecciones</strong>
                <span>Lo que viene en el camino</span>
            </span>
            <span class="catalog-section-nav__count" id="catalog-tab-future-count">@dispositivosFuturos.Count</span>
        </button>
    </nav>

    @* ========================================== *@
    @* SECCIÓN 1: MI COLECCIÓN                     *@
    @* ========================================== *@
    <section id="my-collection" role="tabpanel" aria-labelledby="catalog-tab-current">
        <section class="catalog-overview" aria-label="Resumen de la colección">
            <article class="catalog-stat catalog-stat--featured">
                <span class="catalog-stat__label">PIEZAS EN TU RECORRIDO</span>
                <strong id="catalog-owned-total">@Model.Productos.Count</strong>
                <span class="catalog-stat__detail">registros personales</span>
            </article>
            <article class="catalog-stat">
                <span class="catalog-stat__icon"><i class="bi bi-laptop" aria-hidden="true"></i></span>
                <span class="catalog-stat__label">DISPOSITIVOS</span>
                <strong id="catalog-owned-devices">@Model.TotalDispositivos</strong>
                <span class="catalog-stat__detail">equipos registrados</span>
            </article>
            <article class="catalog-stat">
                <span class="catalog-stat__icon"><i class="bi bi-cpu" aria-hidden="true"></i></span>
                <span class="catalog-stat__label">COMPONENTES</span>
                <strong>@Model.TotalComponentes</strong>
                <span class="catalog-stat__detail">piezas del setup</span>
            </article>
            <article class="catalog-stat">
                <span class="catalog-stat__icon"><i class="bi bi-controller" aria-hidden="true"></i></span>
                <span class="catalog-stat__label">VIDEOJUEGOS</span>
                <strong>@Model.TotalJuegos</strong>
                <span class="catalog-stat__detail">mundos recorridos</span>
            </article>
        </section>

        <section class="catalog-collection" aria-labelledby="collection-title">
            <div class="catalog-collection__heading">
                <div>
                    <span class="catalog-kicker">ARCHIVO / 01</span>
                    <h2 id="collection-title">Mi colección</h2>
                    <p>Equipos, componentes y juegos que ya forman parte de tu historia.</p>
                </div>
            </div>

            <div class="catalog-toolbar">
                <div class="catalog-controls">
                    <div class="catalog-type-filter">
                        <span class="catalog-control-label">Filtrar por tipo</span>
                        <div class="dropdown catalog-type-filter__dropdown">
                            <button class="catalog-type-filter__field" id="catalog-type-filter" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-funnel" aria-hidden="true"></i>
                                <span class="catalog-type-filter__selection">Todos los productos</span>
                                <i class="bi bi-chevron-down catalog-type-filter__chevron" aria-hidden="true"></i>
                            </button>
                            <div class="dropdown-menu catalog-type-filter__menu" aria-labelledby="catalog-type-filter">
                                <button class="dropdown-item catalog-type-filter__option is-selected" type="button"
                                        data-type="TODOS" data-label="Todos los productos" aria-pressed="true">
                                    <span class="catalog-type-filter__option-icon"><i class="bi bi-grid" aria-hidden="true"></i></span>
                                    <span class="catalog-type-filter__option-label">Todos los productos</span>
                                    <span class="catalog-type-filter__count" id="filter-count-todos">@Model.Productos.Count</span>
                                </button>
                                <button class="dropdown-item catalog-type-filter__option" type="button"
                                        data-type="DISPOSITIVO" data-label="Dispositivos" aria-pressed="false">
                                    <span class="catalog-type-filter__option-icon"><i class="bi bi-pc-display" aria-hidden="true"></i></span>
                                    <span class="catalog-type-filter__option-label">Dispositivos</span>
                                    <span class="catalog-type-filter__count" id="filter-count-dispositivos">@Model.TotalDispositivos</span>
                                </button>
                                <button class="dropdown-item catalog-type-filter__option" type="button"
                                        data-type="COMPONENTE" data-label="Componentes" aria-pressed="false">
                                    <span class="catalog-type-filter__option-icon"><i class="bi bi-cpu" aria-hidden="true"></i></span>
                                    <span class="catalog-type-filter__option-label">Componentes</span>
                                    <span class="catalog-type-filter__count">@Model.TotalComponentes</span>
                                </button>
                                <button class="dropdown-item catalog-type-filter__option" type="button"
                                        data-type="JUEGO" data-label="Videojuegos" aria-pressed="false">
                                    <span class="catalog-type-filter__option-icon"><i class="bi bi-controller" aria-hidden="true"></i></span>
                                    <span class="catalog-type-filter__option-label">Videojuegos</span>
                                    <span class="catalog-type-filter__count">@Model.TotalJuegos</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <label class="catalog-search">
                        <span class="catalog-control-label">Buscar en la colección</span>
                        <span class="catalog-search__field">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input id="catalog-search" type="search" placeholder="Escribe el nombre del producto..." autocomplete="off" />
                        </span>
                    </label>
                </div>
                <span class="catalog-results" id="catalog-results" aria-live="polite">@Model.Productos.Count productos</span>
            </div>

            @if (Model.Productos.Count == 0)
            {
                <div class="catalog-empty" id="catalog-main-empty">
                    <span class="catalog-empty__icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                    <h3>Tu colección empieza aquí.</h3>
                    <p>Aún no hay productos asociados a tu cuenta. Cuando registres dispositivos, componentes o juegos, los verás en este espacio.</p>
                    <a asp-controller="Home" asp-action="Index">Volver al inicio <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                </div>
            }
            else
            {
                <div class="catalog-grid" id="catalog-grid">
                    @foreach (var producto in Model.Productos)
                    {
                        var tieneImagen = !string.IsNullOrWhiteSpace(producto.ImagenUrl);
                        <article class="catalog-card"
                                 data-catalog-item
                                 data-type="@producto.Tipo"
                                 data-name="@producto.Nombre"
                                 data-category="@producto.Categoria"
                                 data-category-id="@producto.CategoriaId"
                                 data-brand="@producto.Marca"
                                 data-model="@producto.Modelo"
                                 data-platform="@producto.Plataforma"
                                 data-genre="@producto.Genero"
                                 data-detail="@producto.Detalle"
                                 data-status="@producto.Estado"
                                 data-image="@producto.ImagenUrl"
                                 data-device-id="@producto.DispositivoId"
                                 data-game-id="@producto.JuegoId"
                                 data-collection-state="@producto.EstadoColeccion"
                                 role="button" tabindex="0" aria-haspopup="dialog"
                                 aria-label="Ver detalles de @producto.Nombre">
                            <div class="catalog-card__visual">
                                @if (tieneImagen)
                                {
                                    <img src="@producto.ImagenUrl" alt="Imagen de @producto.Nombre" loading="lazy" />
                                }
                                <div class="catalog-card__placeholder" aria-hidden="true" hidden="@(tieneImagen ? "hidden" : null)">
                                    <span></span><i class="bi @producto.Icono"></i>
                                </div>
                                <span class="catalog-card__type">@producto.Tipo</span>
                            </div>
                            <div class="catalog-card__body">
                                <span class="catalog-card__category">@producto.Categoria</span>
                                <h3>@producto.Nombre</h3>
                                @if (!string.IsNullOrWhiteSpace(producto.Detalle))
                                {
                                    <p class="catalog-card__detail">@producto.Detalle</p>
                                }
                                <div class="catalog-card__meta">
                                    @if (!string.IsNullOrWhiteSpace(producto.Estado))
                                    {
                                        <span class="catalog-card__status"><i aria-hidden="true"></i>@producto.Estado</span>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
                <nav class="catalog-pagination" id="catalog-pagination" aria-label="Paginación del catálogo" hidden>
                    <ul class="catalog-pagination__list" id="catalog-pagination-list"></ul>
                </nav>
                <div class="catalog-empty catalog-empty--filtered" id="catalog-no-results" hidden>
                    <span class="catalog-empty__icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <h3>No encontramos coincidencias.</h3>
                    <p>Prueba con otro nombre, categoría o tipo de producto.</p>
                </div>
            }
        </section>
    </section>

    @* ========================================== *@
    @* SECCIÓN 2: FUTURAS COLECCIONES              *@
    @* ========================================== *@
    <section class="catalog-future" id="future-collections" role="tabpanel" aria-labelledby="catalog-tab-future" hidden>
        <div class="catalog-collection__heading catalog-future__heading d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <span class="catalog-kicker"><i class="bi bi-stars" aria-hidden="true"></i> PRÓXIMOS OBJETIVOS</span>
                <h2>Futuras colecciones</h2>
                <p>Dispositivos que quieres sumar más adelante a tu historia personal.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="catalog-future__badge" id="future-badge-count"><i class="bi bi-hourglass-split" aria-hidden="true"></i> @dispositivosFuturos.Count EN LA LISTA</span>
                <button type="button" class="btn catalog-admin-save" id="btn-open-create-future" data-bs-toggle="modal" data-bs-target="#future-create-modal">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nuevo objetivo
                </button>
            </div>
        </div>

        <div class="catalog-grid catalog-grid--future" id="catalog-future-grid">
            @foreach (var producto in dispositivosFuturos)
            {
                var tieneImagen = !string.IsNullOrWhiteSpace(producto.ImagenUrl);
                <article class="catalog-card" data-future-catalog-item
                         data-type="@producto.Tipo" data-name="@producto.Nombre"
                         data-category="@producto.Categoria" data-category-id="@producto.CategoriaId" data-brand="@producto.Marca"
                         data-model="@producto.Modelo" data-status="@producto.Estado"
                         data-platform="@producto.Plataforma" data-genre="@producto.Genero" data-game-id="@producto.JuegoId"
                         data-image="@producto.ImagenUrl" data-device-id="@producto.DispositivoId"
                         data-collection-state="@producto.EstadoColeccion"
                         role="button" tabindex="0" aria-haspopup="dialog"
                         aria-label="Ver detalles de @producto.Nombre">
                    <div class="catalog-card__visual">
                        @if (tieneImagen)
                        {
                            <img src="@producto.ImagenUrl" alt="Imagen de @producto.Nombre" loading="lazy" />
                        }
                        <div class="catalog-card__placeholder" aria-hidden="true" hidden="@(tieneImagen ? "hidden" : null)">
                            <span></span><i class="bi @producto.Icono"></i>
                        </div>
                        <span class="catalog-card__type">DISPOSITIVO</span>
                    </div>
                    <div class="catalog-card__body">
                        <span class="catalog-card__category">@producto.Categoria</span>
                        <h3>@producto.Nombre</h3>
                        <div class="catalog-card__meta">
                            <span class="catalog-card__status"><i aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(producto.Estado) ? "Deseado" : producto.Estado)</span>
                            <span class="catalog-card__collection-state">DESEADO</span>
                        </div>
                    </div>
                </article>
            }
        </div>
        <div class="catalog-future__empty" id="catalog-future-empty" hidden="@(dispositivosFuturos.Count > 0 ? "hidden" : null)">
            <div class="catalog-future__mark" aria-hidden="true"><span>02</span><i class="bi bi-stars"></i></div>
            <div class="catalog-future__copy">
                <span class="catalog-future__eyebrow">EL SIGUIENTE CAPÍTULO</span>
                <h3>Tus próximas piezas empiezan con una idea.</h3>
                <p>Los dispositivos que registres como deseados aparecerán aquí, listos para marcarse como adquiridos cuando los consigas.</p>
            </div>
            <span class="catalog-future__spark catalog-future__spark--one" aria-hidden="true"></span>
            <span class="catalog-future__spark catalog-future__spark--two" aria-hidden="true"></span>
        </div>
    </section>
</div>

@* ========================================================== *@
@* MODAL MODERNO DE REGISTRO: FUTURAS COLECCIONES (SUPABASE)   *@
@* ========================================================== *@
<div class="modal fade catalog-detail-modal" id="future-create-modal" tabindex="-1" aria-labelledby="future-create-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="catalog-detail-modal__kicker"><i class="bi bi-stars" aria-hidden="true"></i> NUEVO OBJETIVO</span>
                    <h2 class="modal-title" id="future-create-title">Registrar en Futuras Colecciones</h2>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="future-create-form" enctype="multipart/form-data" class="catalog-admin-form">
                    @Html.AntiForgeryToken()
                    <div class="catalog-admin-form__grid">
                        <label>Categoría
                            <select class="form-select" name="IdCategoria" required>
                                <option value="" disabled selected>Selecciona una categoría...</option>
                                @foreach (var categoria in Model.Categorias)
                                {
                                    <option value="@categoria.IdCategoria">@categoria.Nombre</option>
                                }
                            </select>
                        </label>
                        <label>Marca
                            <input class="form-control" name="Marca" maxlength="100" required placeholder="Ej: Sony, Apple, Asus..." />
                        </label>
                        <label>Modelo
                            <input class="form-control" name="Modelo" maxlength="150" required placeholder="Ej: PlayStation 5 Pro, iPhone 16..." />
                        </label>
                        <label class="catalog-admin-form__image">Subir Imagen (Supabase Storage)
                            <input class="form-control" name="Imagen" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
                            <small class="text-white-50 mt-1 d-block">Sube la foto del dispositivo que deseas añadir.</small>
                        </label>
                    </div>
                    <div class="catalog-admin-form__error" id="future-create-error" role="alert" hidden></div>
                </form>
            </div>
            <div class="modal-footer catalog-detail-modal__footer">
                <button type="button" class="btn catalog-admin-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn catalog-admin-save" id="future-create-submit">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" hidden id="future-create-spinner"></span>
                    <i class="bi bi-cloud-arrow-up me-2" aria-hidden="true" id="future-create-icon"></i>Guardar en Futuras Colecciones
                </button>
            </div>
        </div>
    </div>
</div>

@* ========================================================== *@
@* MODAL BOOTSTRAP 5: DETALLES, EDICIÓN Y ELIMINACIÓN         *@
@* ========================================================== *@
<div class="modal fade catalog-detail-modal" id="catalog-detail-modal" tabindex="-1" aria-labelledby="catalog-detail-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="catalog-detail-modal__kicker"><i class="bi bi-info-circle" aria-hidden="true"></i> FICHA DEL PRODUCTO</span>
                    <h2 class="modal-title" id="catalog-detail-title"></h2>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @* Panel de Información Detallada *@
                <div class="catalog-detail-modal__layout" id="catalog-detail-panel">
                    <div class="catalog-detail-modal__visual">
                        <span class="catalog-detail-modal__visual-label"><i class="bi bi-box-seam" aria-hidden="true"></i> PIEZA DE TU RECORRIDO</span>
                        <span class="catalog-detail-modal__visual-orbit" aria-hidden="true"></span>
                        <img id="catalog-detail-image" alt="" hidden />
                        <div class="catalog-detail-modal__placeholder" id="catalog-detail-placeholder" aria-hidden="true"><i class="bi bi-box-seam"></i></div>
                    </div>
                    <div class="catalog-detail-modal__information">
                        <span class="catalog-detail-modal__type" id="catalog-detail-type"></span>
                        <span class="catalog-detail-modal__section-label">DETALLES DEL PRODUCTO</span>
                        <dl class="catalog-detail-modal__list" id="catalog-detail-list"></dl>
                    </div>
                </div>

                @if (esAdmin)
                {
                    @* Formulario de Edición (Solo ADMIN) *@
                    <form id="catalog-device-edit-form" method="post" class="catalog-admin-form" hidden>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdDispositivo" />
                        <input type="hidden" name="IdJuego" />
                        <div class="catalog-admin-form__grid" id="catalog-edit-fields">
                            <label data-device-field>Marca<input class="form-control" name="Marca" maxlength="100" /></label>
                            <label data-device-field>Modelo<input class="form-control" name="Modelo" maxlength="150" /></label>
                            <label data-game-field>Título<input class="form-control" name="Titulo" maxlength="200" /></label>
                            <label data-game-field>Plataforma<input class="form-control" name="Plataforma" maxlength="100" /></label>
                            <label data-game-field>Género<input class="form-control" name="Genero" maxlength="100" /></label>
                            <label>Categoría
                                <select class="form-select" name="IdCategoria" required>
                                    @foreach (var categoria in Model.Categorias)
                                    {
                                        <option value="@categoria.IdCategoria">@categoria.Nombre</option>
                                    }
                                </select>
                            </label>
                            <label>Estado<input class="form-control" name="Estado" required maxlength="100" /></label>
                            <label data-device-field>Estado de Colección
                                <select class="form-select" name="EstadoColeccion" required>
                                    <option value="COLECCION">Mi colección</option>
                                    <option value="DESEADO">Futuras colecciones</option>
                                </select>
                            </label>
                            <label class="catalog-admin-form__image">URL de Imagen<input class="form-control" name="ImagenUrl" type="url" maxlength="500" placeholder="https://..." /></label>
                        </div>
                        <div class="catalog-admin-form__error" id="catalog-edit-error" role="alert" hidden></div>
                    </form>

                    @* Diálogo de Confirmación para Eliminar *@
                    <div class="catalog-delete-confirm" id="catalog-delete-confirm" hidden>
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        <h3 id="catalog-delete-confirm-title">¿Estás seguro de eliminar este producto?</h3>
                        <p id="catalog-delete-confirm-message">Esta acción eliminará definitivamente el registro de la base de datos PostgreSQL y no se puede deshacer.</p>
                        <div class="catalog-delete-confirm__actions">
                            <button type="button" class="btn catalog-admin-secondary" id="catalog-delete-cancel">Cancelar</button>
                            <button type="button" class="btn catalog-admin-danger" id="catalog-delete-confirm-button">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" hidden id="delete-spinner"></span>
                                Sí, eliminar
                            </button>
                        </div>
                        <div class="catalog-admin-form__error" id="catalog-delete-error" role="alert" hidden></div>
                    </div>
                }
            </div>

            <div class="modal-footer catalog-detail-modal__footer">
                @* Botón de Acción Especial: Marcar Como Adquirido *@
                <button type="button" class="btn catalog-admin-save" id="btn-marcar-adquirido" hidden>
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" hidden id="adquirido-spinner"></span>
                    <i class="bi bi-bag-check-fill me-2" aria-hidden="true" id="adquirido-icon"></i>Marcar como adquirido
                </button>

                @if (esAdmin)
                {
                    <div class="catalog-admin-actions" id="catalog-admin-actions" hidden>
                        <button type="button" class="btn catalog-admin-secondary" id="catalog-edit-button"><i class="bi bi-pencil me-2" aria-hidden="true"></i>Editar</button>
                        <button type="button" class="btn catalog-admin-danger" id="catalog-delete-button"><i class="bi bi-trash me-2" aria-hidden="true"></i>Eliminar</button>
                    </div>
                    <div class="catalog-admin-actions" id="catalog-edit-actions" hidden>
                        <button type="button" class="btn catalog-admin-secondary" id="catalog-edit-cancel">Cancelar</button>
                        <button type="button" class="btn catalog-admin-save" id="catalog-edit-save">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" hidden id="edit-spinner"></span>
                            <i class="bi bi-check2 me-2" aria-hidden="true" id="edit-save-icon"></i>Guardar cambios
                        </button>
                    </div>
                }
                <button type="button" class="btn catalog-detail-modal__close-action" id="catalog-modal-close" data-bs-dismiss="modal">
                    <i class="bi bi-check2 me-2" aria-hidden="true"></i>Listo
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const page = document.querySelector(".catalog-page");
            const tabs = Array.from(document.querySelectorAll("[data-catalog-section]"));
            const panels = tabs.map((tab) => document.getElementById(tab.dataset.catalogSection));
            const initialPanel = page.dataset.initialSection;

            const activateTab = (selectedTab, focusTab = false) => {
                tabs.forEach((tab, index) => {
                    const selected = tab === selectedTab;
                    tab.setAttribute("aria-selected", String(selected));
                    tab.tabIndex = selected ? 0 : -1;
                    panels[index].hidden = !selected;
                });
                if (focusTab) selectedTab.focus();
            };

            tabs.forEach((tab, index) => {
                tab.addEventListener("click", () => activateTab(tab));
                tab.addEventListener("keydown", (event) => {
                    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
                    event.preventDefault();
                    const step = event.key === "ArrowRight" ? 1 : -1;
                    activateTab(tabs[(index + step + tabs.length) % tabs.length], true);
                });
            });

            activateTab(tabs.find((tab) => tab.dataset.catalogSection === initialPanel) || tabs[0]);
        })();

        // Módulo de Filtrado y Paginación
        const CatalogFilter = (() => {
            const grid = document.getElementById("catalog-grid");
            const searchInput = document.getElementById("catalog-search");
            const resultsLabel = document.getElementById("catalog-results");
            const noResults = document.getElementById("catalog-no-results");
            const pagination = document.getElementById("catalog-pagination");
            const paginationList = document.getElementById("catalog-pagination-list");
            const typeOptions = Array.from(document.querySelectorAll(".catalog-type-filter__option"));
            const pageSize = 9;
            let activeFilter = "TODOS";
            let currentPage = 1;

            const getItems = () => grid ? Array.from(grid.querySelectorAll("[data-catalog-item]")) : [];

            const showPage = () => {
                if (!grid) return;
                const items = getItems();
                const query = (searchInput?.value || "").trim().toLocaleLowerCase("es");
                const matches = items.filter((item) => {
                    const matchesType = activeFilter === "TODOS" || item.dataset.type === activeFilter;
                    const matchesText = `${item.dataset.name} ${item.dataset.category} ${item.dataset.brand}`
                        .toLocaleLowerCase("es").includes(query);
                    return matchesType && matchesText;
                });
                const pageCount = Math.ceil(matches.length / pageSize);
                currentPage = Math.min(currentPage, Math.max(pageCount, 1));
                const visibleItems = new Set(matches.slice((currentPage - 1) * pageSize, currentPage * pageSize));
                items.forEach((item) => item.hidden = !visibleItems.has(item));
                if (resultsLabel) {
                    resultsLabel.textContent = `${matches.length} ${matches.length === 1 ? "producto" : "productos"}`;
                }
                if (noResults) noResults.hidden = matches.length > 0;
                if (pagination) pagination.hidden = pageCount <= 1;
                if (paginationList) paginationList.replaceChildren();

                const addPageButton = (label, pageNumber, current = false, disabled = false) => {
                    const listItem = document.createElement("li");
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "catalog-page-button";
                    button.textContent = label;
                    button.disabled = disabled;
                    if (current) button.setAttribute("aria-current", "page");
                    button.addEventListener("click", () => {
                        currentPage = pageNumber;
                        showPage();
                    });
                    listItem.append(button);
                    paginationList.append(listItem);
                };

                if (pageCount > 1 && paginationList) {
                    addPageButton("‹", currentPage - 1, false, currentPage === 1);
                    for (let pageNumber = 1; pageNumber <= pageCount; pageNumber += 1) {
                        addPageButton(String(pageNumber), pageNumber, pageNumber === currentPage);
                    }
                    addPageButton("›", currentPage + 1, false, currentPage === pageCount);
                }
            };

            typeOptions.forEach((option) => option.addEventListener("click", () => {
                activeFilter = option.dataset.type;
                currentPage = 1;
                typeOptions.forEach((candidate) => {
                    const selected = candidate === option;
                    candidate.classList.toggle("is-selected", selected);
                    candidate.setAttribute("aria-pressed", String(selected));
                });
                const sel = document.querySelector(".catalog-type-filter__selection");
                if (sel) sel.textContent = option.dataset.label;
                const dropdownInstance = bootstrap.Dropdown.getInstance(document.getElementById("catalog-type-filter"));
                if (dropdownInstance) dropdownInstance.hide();
                showPage();
            }));

            if (searchInput) {
                searchInput.addEventListener("input", () => {
                    currentPage = 1;
                    showPage();
                });
            }

            showPage();
            return { refresh: showPage };
        })();

        // Módulo de Modal y Gestión de Productos
        (() => {
            const modalElement = document.getElementById("catalog-detail-modal");
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const detailTitle = document.getElementById("catalog-detail-title");
            const detailType = document.getElementById("catalog-detail-type");
            const detailImage = document.getElementById("catalog-detail-image");
            const detailPlaceholder = document.getElementById("catalog-detail-placeholder");
            const detailList = document.getElementById("catalog-detail-list");
            const detailPanel = document.getElementById("catalog-detail-panel");
            const editForm = document.getElementById("catalog-device-edit-form");
            const editFields = document.getElementById("catalog-edit-fields");
            const adminActions = document.getElementById("catalog-admin-actions");
            const editActions = document.getElementById("catalog-edit-actions");
            const deleteConfirm = document.getElementById("catalog-delete-confirm");
            const closeButton = document.getElementById("catalog-modal-close");
            const btnMarcarAdquirido = document.getElementById("btn-marcar-adquirido");
            const deviceFields = Array.from(document.querySelectorAll("[data-device-field]"));
            const gameFields = Array.from(document.querySelectorAll("[data-game-field]"));
            let selectedItem = null;

            const isAdmin = Boolean(editForm);

            const appendDetail = (label, value) => {
                if (!value) return;
                const row = document.createElement("div");
                const term = document.createElement("dt");
                const description = document.createElement("dd");
                row.className = "catalog-detail-modal__field";
                term.textContent = label;
                description.textContent = value;
                row.append(term, description);
                detailList.append(row);
            };

            const openDetails = (item) => {
                selectedItem = item;
                const product = item.dataset;
                detailTitle.textContent = product.name;
                detailType.textContent = `${product.category || "Producto"} · ${product.type}`;
                detailList.replaceChildren();
                appendDetail("Marca", product.brand);
                appendDetail("Modelo", product.model);
                appendDetail("Plataforma", product.platform);
                appendDetail("Género", product.genre);
                appendDetail("Categoría", product.category);
                appendDetail("Estado", product.status || (product.collectionState === "DESEADO" ? "Deseado" : null));
                if (product.type === "DISPOSITIVO") {
                    appendDetail("Estado de Colección", product.collectionState === "DESEADO" ? "Futuras colecciones" : "Mi colección");
                }

                detailImage.hidden = true;
                detailImage.removeAttribute("src");
                detailPlaceholder.hidden = false;
                detailImage.alt = `Imagen de ${product.name}`;
                const icon = item.querySelector(".catalog-card__placeholder i");
                detailPlaceholder.replaceChildren();
                const placeholderIcon = document.createElement("i");
                placeholderIcon.className = icon?.className || "bi bi-box-seam";
                detailPlaceholder.append(placeholderIcon);
                if (product.image) {
                    detailImage.onerror = () => {
                        detailImage.hidden = true;
                        detailPlaceholder.hidden = false;
                    };
                    detailImage.onload = () => {
                        detailImage.hidden = false;
                        detailPlaceholder.hidden = true;
                    };
                    detailImage.src = product.image;
                }

                // Botón especial: Marcar como adquirido (solo para productos en DESEADO)
                const isDesired = product.type === "DISPOSITIVO" && product.collectionState === "DESEADO" && product.deviceId;
                if (btnMarcarAdquirido) {
                    btnMarcarAdquirido.hidden = !isDesired;
                }

                if (isAdmin) {
                    const isDevice = product.type === "DISPOSITIVO" && product.deviceId;
                    const isGame = product.type === "JUEGO" && product.gameId;
                    const editable = Boolean(isDevice || isGame);
                    adminActions.hidden = !editable;
                    editActions.hidden = true;
                    closeButton.hidden = false;
                    editForm.hidden = true;
                    editFields.hidden = false;
                    detailPanel.hidden = false;
                    deleteConfirm.hidden = true;
                    deviceFields.forEach((field) => {
                        field.hidden = !isDevice;
                        field.querySelectorAll("input, select").forEach((input) => {
                            input.required = isDevice && input.name === "EstadoColeccion";
                        });
                    });
                    gameFields.forEach((field) => {
                        field.hidden = !isGame;
                        field.querySelectorAll("input").forEach((input) => {
                            input.required = isGame && ["Titulo", "Plataforma"].includes(input.name);
                        });
                    });
                    editForm.elements.IdDispositivo.value = product.deviceId || "";
                    editForm.elements.IdJuego.value = product.gameId || "";
                    editForm.elements.Marca.value = product.brand || "";
                    editForm.elements.Modelo.value = product.model || "";
                    editForm.elements.Titulo.value = product.name || "";
                    editForm.elements.Plataforma.value = product.platform || "";
                    editForm.elements.Genero.value = product.genre || "";
                    editForm.elements.IdCategoria.value = item.dataset.categoryId || "";
                    editForm.elements.Estado.value = product.status || "";
                    editForm.elements.EstadoColeccion.value = product.collectionState || "COLECCION";
                    editForm.elements.ImagenUrl.value = product.image || "";
                }

                modal.show();
            };

            const bindCardEvents = (card) => {
                card.addEventListener("click", () => openDetails(card));
                card.addEventListener("keydown", (event) => {
                    if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        openDetails(card);
                    }
                });
            };

            document.querySelectorAll("[data-catalog-item], [data-future-catalog-item]").forEach(bindCardEvents);

            document.querySelectorAll(".catalog-card__visual img").forEach((image) => {
                image.addEventListener("error", () => {
                    image.hidden = true;
                    const placeholder = image.nextElementSibling;
                    if (placeholder) placeholder.hidden = false;
                });
            });

            const showAdminMode = (mode) => {
                detailPanel.hidden = mode !== "details";
                if (editForm) {
                    editForm.hidden = mode !== "edit";
                    editFields.hidden = mode !== "edit";
                }
                if (deleteConfirm) deleteConfirm.hidden = mode !== "delete";
                if (adminActions) adminActions.hidden = mode !== "details" || !(selectedItem?.dataset.deviceId || selectedItem?.dataset.gameId);
                if (editActions) editActions.hidden = mode !== "edit";
                closeButton.hidden = mode !== "details";
                if (btnMarcarAdquirido) {
                    const isDesired = selectedItem?.dataset.type === "DISPOSITIVO" && selectedItem?.dataset.collectionState === "DESEADO";
                    btnMarcarAdquirido.hidden = mode !== "details" || !isDesired;
                }
                const editError = document.getElementById("catalog-edit-error");
                const delError = document.getElementById("catalog-delete-error");
                if (editError) editError.hidden = true;
                if (delError) delError.hidden = true;
                if (mode === "delete") {
                    const itemName = selectedItem?.dataset.name || "este producto";
                    document.getElementById("catalog-delete-confirm-title").textContent = `¿Estás seguro de eliminar este producto?`;
                    document.getElementById("catalog-delete-confirm-message").textContent = `¿Confirmas eliminar ${itemName}? Se eliminará permanentemente de PostgreSQL.`;
                }
            };

            if (isAdmin) {
                document.getElementById("catalog-edit-button")?.addEventListener("click", () => showAdminMode("edit"));
                document.getElementById("catalog-edit-cancel")?.addEventListener("click", () => showAdminMode("details"));
                document.getElementById("catalog-delete-button")?.addEventListener("click", () => showAdminMode("delete"));
                document.getElementById("catalog-delete-cancel")?.addEventListener("click", () => showAdminMode("details"));
            }

            // Actualización DOM Instantánea tras Editar
            const updateCardInDOM = (card, data) => {
                card.dataset.name = data.nombre;
                card.dataset.brand = data.marca;
                card.dataset.model = data.modelo;
                card.dataset.category = data.categoria;
                card.dataset.categoryId = data.idCategoria;
                card.dataset.status = data.estado;
                card.dataset.image = data.imagenUrl || "";
                
                const titleEl = card.querySelector("h3");
                if (titleEl) titleEl.textContent = data.nombre;

                const catEl = card.querySelector(".catalog-card__category");
                if (catEl) catEl.textContent = data.categoria;

                const statusEl = card.querySelector(".catalog-card__status");
                if (statusEl) {
                    statusEl.innerHTML = `<i aria-hidden="true"></i>${data.estado}`;
                }

                const imgContainer = card.querySelector(".catalog-card__visual");
                if (imgContainer) {
                    let img = imgContainer.querySelector("img");
                    const placeholder = imgContainer.querySelector(".catalog-card__placeholder");
                    if (data.imagenUrl) {
                        if (!img) {
                            img = document.createElement("img");
                            img.alt = `Imagen de ${data.nombre}`;
                            img.loading = "lazy";
                            imgContainer.prepend(img);
                        }
                        img.src = data.imagenUrl;
                        img.hidden = false;
                        if (placeholder) placeholder.hidden = true;
                    } else {
                        if (img) img.remove();
                        if (placeholder) placeholder.hidden = false;
                    }
                }

                // Si cambió el estado de colección (Mi colección vs Futuras colecciones), moverlo de contenedor
                const oldState = card.dataset.collectionState;
                const newState = data.estadoColeccion;
                if (oldState !== newState) {
                    card.dataset.collectionState = newState;
                    const mainGrid = document.getElementById("catalog-grid");
                    const futureGrid = document.getElementById("catalog-future-grid");
                    const futureEmpty = document.getElementById("catalog-future-empty");

                    if (newState === "DESEADO" && futureGrid) {
                        card.removeAttribute("data-catalog-item");
                        card.setAttribute("data-future-catalog-item", "");
                        let meta = card.querySelector(".catalog-card__meta");
                        if (meta && !meta.querySelector(".catalog-card__collection-state")) {
                            const badge = document.createElement("span");
                            badge.className = "catalog-card__collection-state";
                            badge.textContent = "DESEADO";
                            meta.append(badge);
                        }
                        futureGrid.appendChild(card);
                        if (futureEmpty) futureEmpty.hidden = true;
                    } else if (newState === "COLECCION" && mainGrid) {
                        card.removeAttribute("data-future-catalog-item");
                        card.setAttribute("data-catalog-item", "");
                        const badge = card.querySelector(".catalog-card__collection-state");
                        if (badge) badge.remove();
                        mainGrid.prepend(card);
                    }
                    updateCounts();
                }
            };

            const removeCardFromDOM = (card) => {
                const isFuture = card.hasAttribute("data-future-catalog-item");
                card.remove();
                if (isFuture) {
                    const futureGrid = document.getElementById("catalog-future-grid");
                    const futureEmpty = document.getElementById("catalog-future-empty");
                    if (futureGrid && futureGrid.querySelectorAll("[data-future-catalog-item]").length === 0 && futureEmpty) {
                        futureEmpty.hidden = false;
                    }
                }
                updateCounts();
            };

            const updateCounts = () => {
                const totalOwned = document.querySelectorAll("#catalog-grid [data-catalog-item]").length;
                const totalDevices = document.querySelectorAll("#catalog-grid [data-catalog-item][data-type='DISPOSITIVO']").length;
                const totalFuture = document.querySelectorAll("#catalog-future-grid [data-future-catalog-item]").length;

                const tabCount = document.getElementById("catalog-tab-count");
                if (tabCount) tabCount.textContent = totalOwned;

                const tabFutureCount = document.getElementById("catalog-tab-future-count");
                if (tabFutureCount) tabFutureCount.textContent = totalFuture;

                const ownedTotal = document.getElementById("catalog-owned-total");
                if (ownedTotal) ownedTotal.textContent = totalOwned;

                const ownedDevices = document.getElementById("catalog-owned-devices");
                if (ownedDevices) ownedDevices.textContent = totalDevices;

                const filterTodos = document.getElementById("filter-count-todos");
                if (filterTodos) filterTodos.textContent = totalOwned;

                const filterDispositivos = document.getElementById("filter-count-dispositivos");
                if (filterDispositivos) filterDispositivos.textContent = totalDevices;

                const futureBadge = document.getElementById("future-badge-count");
                if (futureBadge) futureBadge.innerHTML = `<i class="bi bi-hourglass-split" aria-hidden="true"></i> ${totalFuture} EN LA LISTA`;

                CatalogFilter.refresh();
            };

            // ACCIÓN ESPECIAL: Marcar Como Adquirido
            if (btnMarcarAdquirido) {
                btnMarcarAdquirido.addEventListener("click", async () => {
                    if (!selectedItem) return;
                    const id = Number(selectedItem.dataset.deviceId);
                    const spinner = document.getElementById("adquirido-spinner");
                    const icon = document.getElementById("adquirido-icon");
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

                    btnMarcarAdquirido.disabled = true;
                    if (spinner) spinner.hidden = false;
                    if (icon) icon.hidden = true;

                    try {
                        const response = await fetch("/Catalogo/MarcarComoAdquirido", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "Accept": "application/json",
                                "RequestVerificationToken": token,
                                "X-CSRF-TOKEN": token
                            },
                            body: JSON.stringify({ idDispositivo: id })
                        });

                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            throw new Error(result.message || "No se pudo marcar como adquirido.");
                        }

                        // Mover inmediatamente la tarjeta a Mi Colección sin recarga
                        updateCardInDOM(selectedItem, result.data);
                        modal.hide();

                        // Opcional: mostrar un aviso visual rápido o activar pestaña Mi Colección
                        const tabCurrent = document.getElementById("catalog-tab-current");
                        if (tabCurrent) tabCurrent.click();
                    } catch (ex) {
                        alert(ex.message);
                    } finally {
                        btnMarcarAdquirido.disabled = false;
                        if (spinner) spinner.hidden = true;
                        if (icon) icon.hidden = false;
                    }
                });
            }

            // Guardar Cambios (Editar) vía AJAX al Controlador MVC
            if (isAdmin) {
                document.getElementById("catalog-edit-save")?.addEventListener("click", async () => {
                    const error = document.getElementById("catalog-edit-error");
                    const saveButton = document.getElementById("catalog-edit-save");
                    const spinner = document.getElementById("edit-spinner");
                    const saveIcon = document.getElementById("edit-save-icon");
                    if (error) error.hidden = true;

                    if (!editForm.checkValidity()) {
                        editForm.reportValidity();
                        return;
                    }

                    saveButton.disabled = true;
                    if (spinner) spinner.hidden = false;
                    if (saveIcon) saveIcon.hidden = true;

                    try {
                        const isGame = Boolean(selectedItem.dataset.gameId);
                        const token = editForm.elements.__RequestVerificationToken.value;
                        const headers = {
                            "Content-Type": "application/json",
                            "Accept": "application/json",
                            "RequestVerificationToken": token,
                            "X-CSRF-TOKEN": token
                        };

                        if (!isGame) {
                            const payload = {
                                idDispositivo: Number(editForm.elements.IdDispositivo.value),
                                idCategoria: Number(editForm.elements.IdCategoria.value),
                                marca: editForm.elements.Marca.value,
                                modelo: editForm.elements.Modelo.value,
                                estado: editForm.elements.Estado.value,
                                estadoColeccion: editForm.elements.EstadoColeccion.value,
                                imagenUrl: editForm.elements.ImagenUrl.value || null
                            };

                            const response = await fetch("/Catalogo/Editar", {
                                method: "POST",
                                headers,
                                body: JSON.stringify(payload)
                            });

                            const result = await response.json();
                            if (!response.ok || !result.success) {
                                throw new Error(result.message || (result.errors ? result.errors.join(", ") : "Error al actualizar."));
                            }

                            updateCardInDOM(selectedItem, result.data);
                            openDetails(selectedItem);
                            showAdminMode("details");
                        } else {
                            const id = selectedItem.dataset.gameId;
                            const payload = {
                                idCategoria: Number(editForm.elements.IdCategoria.value),
                                titulo: editForm.elements.Titulo.value,
                                plataforma: editForm.elements.Plataforma.value,
                                genero: editForm.elements.Genero.value,
                                estado: editForm.elements.Estado.value,
                                imagenUrl: editForm.elements.ImagenUrl.value || null
                            };

                            const response = await fetch(`/api/catalogo/juegos/${encodeURIComponent(id)}`, {
                                method: "PUT",
                                headers,
                                body: JSON.stringify(payload)
                            });
                            if (!response.ok) throw new Error("Error al actualizar el juego.");
                            window.location.reload();
                        }
                    } catch (exception) {
                        if (error) {
                            error.textContent = exception.message;
                            error.hidden = false;
                        }
                    } finally {
                        saveButton.disabled = false;
                        if (spinner) spinner.hidden = true;
                        if (saveIcon) saveIcon.hidden = false;
                    }
                });

                // Confirmar Eliminación vía AJAX al Controlador MVC
                document.getElementById("catalog-delete-confirm-button")?.addEventListener("click", async () => {
                    const error = document.getElementById("catalog-delete-error");
                    const button = document.getElementById("catalog-delete-confirm-button");
                    const spinner = document.getElementById("delete-spinner");
                    if (error) error.hidden = true;
                    button.disabled = true;
                    if (spinner) spinner.hidden = false;

                    try {
                        const isGame = Boolean(selectedItem.dataset.gameId);
                        const token = editForm.elements.__RequestVerificationToken.value;
                        const headers = {
                            "Content-Type": "application/json",
                            "Accept": "application/json",
                            "RequestVerificationToken": token,
                            "X-CSRF-TOKEN": token
                        };

                        if (!isGame) {
                            const id = Number(selectedItem.dataset.deviceId);
                            const response = await fetch("/Catalogo/Eliminar", {
                                method: "POST",
                                headers,
                                body: JSON.stringify({ idDispositivo: id })
                            });

                            const result = await response.json();
                            if (!response.ok || !result.success) {
                                throw new Error(result.message || "Error al eliminar el dispositivo.");
                            }

                            modal.hide();
                            removeCardFromDOM(selectedItem);
                        } else {
                            const id = selectedItem.dataset.gameId;
                            const response = await fetch(`/api/catalogo/juegos/${encodeURIComponent(id)}`, {
                                method: "DELETE",
                                headers
                            });
                            if (!response.ok) throw new Error("Error al eliminar el juego.");
                            modal.hide();
                            removeCardFromDOM(selectedItem);
                        }
                    } catch (exception) {
                        if (error) {
                            error.textContent = exception.message;
                            error.hidden = false;
                        }
                    } finally {
                        button.disabled = false;
                        if (spinner) spinner.hidden = true;
                    }
                });
            }

            // CREAR NUEVA FUTURA COLECCIÓN (SUBIDA A SUPABASE STORAGE Y GUARDADO EN POSTGRESQL)
            const futureCreateModalEl = document.getElementById("future-create-modal");
            const futureCreateModal = futureCreateModalEl ? bootstrap.Modal.getOrCreateInstance(futureCreateModalEl) : null;
            const futureCreateForm = document.getElementById("future-create-form");
            const btnFutureCreateSubmit = document.getElementById("future-create-submit");

            if (btnFutureCreateSubmit && futureCreateForm) {
                btnFutureCreateSubmit.addEventListener("click", async () => {
                    const errorEl = document.getElementById("future-create-error");
                    const spinner = document.getElementById("future-create-spinner");
                    const icon = document.getElementById("future-create-icon");
                    if (errorEl) errorEl.hidden = true;

                    if (!futureCreateForm.checkValidity()) {
                        futureCreateForm.reportValidity();
                        return;
                    }

                    btnFutureCreateSubmit.disabled = true;
                    if (spinner) spinner.hidden = false;
                    if (icon) icon.hidden = true;

                    const formData = new FormData(futureCreateForm);

                    try {
                        const response = await fetch("/Catalogo/CrearFuturaColeccion", {
                            method: "POST",
                            body: formData
                        });

                        const result = await response.json();
                        if (!response.ok || !result.success) {
                            throw new Error(result.message || (result.errors ? result.errors.join(", ") : "Error al registrar producto."));
                        }

                        // Crear la tarjeta en el grid de Futuras Colecciones en tiempo real
                        const futureGrid = document.getElementById("catalog-future-grid");
                        const futureEmpty = document.getElementById("catalog-future-empty");
                        const p = result.data;
                        const tieneImg = Boolean(p.imagenUrl);

                        const article = document.createElement("article");
                        article.className = "catalog-card";
                        article.setAttribute("data-future-catalog-item", "");
                        article.dataset.type = p.tipo;
                        article.dataset.name = p.nombre;
                        article.dataset.category = p.categoria;
                        article.dataset.categoryId = p.categoriaId;
                        article.dataset.brand = p.marca;
                        article.dataset.model = p.modelo;
                        article.dataset.status = p.estado;
                        article.dataset.image = p.imagenUrl || "";
                        article.dataset.deviceId = p.dispositivoId;
                        article.dataset.collectionState = p.estadoColeccion;
                        article.setAttribute("role", "button");
                        article.setAttribute("tabindex", "0");
                        article.setAttribute("aria-haspopup", "dialog");
                        article.setAttribute("aria-label", `Ver detalles de ${p.nombre}`);

                        article.innerHTML = `
                            <div class="catalog-card__visual">
                                ${tieneImg ? `<img src="${p.imagenUrl}" alt="Imagen de ${p.nombre}" loading="lazy" />` : ""}
                                <div class="catalog-card__placeholder" aria-hidden="true" ${tieneImg ? 'hidden="hidden"' : ''}>
                                    <span></span><i class="bi ${p.icono}"></i>
                                </div>
                                <span class="catalog-card__type">DISPOSITIVO</span>
                            </div>
                            <div class="catalog-card__body">
                                <span class="catalog-card__category">${p.categoria}</span>
                                <h3>${p.nombre}</h3>
                                <div class="catalog-card__meta">
                                    <span class="catalog-card__status"><i aria-hidden="true"></i>${p.estado}</span>
                                    <span class="catalog-card__collection-state">DESEADO</span>
                                </div>
                            </div>
                        `;

                        bindCardEvents(article);
                        if (futureGrid) {
                            futureGrid.prepend(article);
                        }
                        if (futureEmpty) futureEmpty.hidden = true;

                        updateCounts();
                        futureCreateForm.reset();
                        if (futureCreateModal) futureCreateModal.hide();
                    } catch (ex) {
                        if (errorEl) {
                            errorEl.textContent = ex.message;
                            errorEl.hidden = false;
                        }
                    } finally {
                        btnFutureCreateSubmit.disabled = false;
                        if (spinner) spinner.hidden = true;
                        if (icon) icon.hidden = false;
                    }
                });
            }

        })();
    </script>
}

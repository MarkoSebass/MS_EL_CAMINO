@using System.Globalization
@model MS_EL_CAMINO.ViewModels.CatalogoViewModel
@{
    ViewData["Title"] = "Catálogo tecnológico";
    var currencyCulture = CultureInfo.GetCultureInfo("es-PE");
}

<div class="catalog-page">
    <header class="catalog-hero">
        <div class="catalog-hero__copy">
            <span class="catalog-kicker"><i class="bi bi-compass-fill" aria-hidden="true"></i> KM-001 / COLECCIÓN PERSONAL</span>
            <h1>Lo que forma<br />parte del <span>camino.</span></h1>
            <p>Un registro vivo de los dispositivos, componentes y juegos que acompañan cada etapa de tu historia tecnológica.</p>
        </div>
        <div class="catalog-hero__mark" aria-hidden="true">
            <span class="catalog-hero__orbit"></span>
            <i class="bi bi-box-seam"></i>
            <span class="catalog-hero__coordinates">EL CAMINO · 001</span>
        </div>
    </header>

    <section class="catalog-overview" aria-label="Resumen de la colección">
        <article class="catalog-stat catalog-stat--featured">
            <span class="catalog-stat__label">PIEZAS EN TU RECORRIDO</span>
            <strong>@Model.Productos.Count</strong>
            <span class="catalog-stat__detail">registros personales</span>
        </article>
        <article class="catalog-stat">
            <span class="catalog-stat__icon"><i class="bi bi-laptop" aria-hidden="true"></i></span>
            <span class="catalog-stat__label">DISPOSITIVOS</span>
            <strong>@Model.TotalDispositivos</strong>
            <span class="catalog-stat__detail">equipos registrados</span>
        </article>
        <article class="catalog-stat">
            <span class="catalog-stat__icon"><i class="bi bi-cpu" aria-hidden="true"></i></span>
            <span class="catalog-stat__label">COMPONENTES</span>
            <strong>@Model.TotalComponentes</strong>
            <span class="catalog-stat__detail">piezas del setup</span>
        </article>
        <article class="catalog-stat">
            <span class="catalog-stat__icon"><i class="bi bi-controller" aria-hidden="true"></i></span>
            <span class="catalog-stat__label">VIDEOJUEGOS</span>
            <strong>@Model.TotalJuegos</strong>
            <span class="catalog-stat__detail">mundos recorridos</span>
        </article>
        <article class="catalog-stat catalog-stat--investment">
            <span class="catalog-stat__label">INVERSIÓN REGISTRADA</span>
            <strong>@Model.InversionTotal.ToString("C", currencyCulture)</strong>
            <span class="catalog-stat__detail">suma de los importes disponibles</span>
        </article>
    </section>

    <section class="catalog-collection" aria-labelledby="collection-title">
        <div class="catalog-collection__heading">
            <div>
                <span class="catalog-kicker">ARCHIVO / 01</span>
                <h2 id="collection-title">Tu colección</h2>
                <p>Todos tus registros, reunidos en un solo lugar.</p>
            </div>
            <label class="catalog-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <span class="visually-hidden">Buscar en el catálogo</span>
                <input id="catalog-search" type="search" placeholder="Buscar por nombre, tipo o estado..." autocomplete="off" />
            </label>
        </div>

        <div class="catalog-toolbar">
            <div class="catalog-filters" role="group" aria-label="Filtrar catálogo por tipo">
                <button type="button" class="catalog-filter is-active" data-catalog-filter="TODOS" aria-pressed="true">Todo <span>@Model.Productos.Count</span></button>
                <button type="button" class="catalog-filter" data-catalog-filter="DISPOSITIVO" aria-pressed="false">Dispositivos <span>@Model.TotalDispositivos</span></button>
                <button type="button" class="catalog-filter" data-catalog-filter="COMPONENTE" aria-pressed="false">Componentes <span>@Model.TotalComponentes</span></button>
                <button type="button" class="catalog-filter" data-catalog-filter="JUEGO" aria-pressed="false">Videojuegos <span>@Model.TotalJuegos</span></button>
            </div>
            <span class="catalog-results" id="catalog-results" aria-live="polite">@Model.Productos.Count productos</span>
        </div>

        @if (Model.Productos.Count == 0)
        {
            <div class="catalog-empty">
                <span class="catalog-empty__icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                <h3>Tu colección empieza aquí.</h3>
                <p>Aún no hay productos asociados a tu cuenta. Cuando registres dispositivos, componentes o juegos, los verás en este espacio.</p>
                <a asp-controller="Dashboard" asp-action="Index">Volver al Dashboard <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div class="catalog-grid" id="catalog-grid">
                @foreach (var producto in Model.Productos)
                {
                    var searchText = $"{producto.Nombre} {producto.Categoria} {producto.Detalle} {producto.Estado} {producto.Tipo}";
                    var tieneImagen = !string.IsNullOrWhiteSpace(producto.ImagenUrl);
                    <article class="catalog-card"
                             data-catalog-item
                             data-type="@producto.Tipo"
                             data-search="@searchText"
                             data-category="@producto.Categoria"
                             data-brand="@producto.Marca"
                             data-model="@producto.Modelo"
                             data-platform="@producto.Plataforma"
                             data-genre="@producto.Genero"
                             data-detail="@producto.Detalle"
                             data-status="@producto.Estado"
                             data-purchase-date="@(producto.FechaCompra?.ToDateTime(TimeOnly.MinValue).ToString("dd MMM yyyy", currencyCulture))"
                             data-price="@(producto.Precio?.ToString("C", currencyCulture))"
                             data-image="@producto.ImagenUrl"
                             role="button"
                             tabindex="0"
                             aria-haspopup="dialog"
                             aria-label="Ver detalles de @producto.Nombre">
                        <div class="catalog-card__visual">
                            @if (tieneImagen)
                            {
                                <img src="@producto.ImagenUrl" alt="@producto.Nombre" loading="lazy" />
                            }
                            <div class="catalog-card__placeholder" aria-hidden="true" hidden="@(tieneImagen ? "hidden" : null)">
                                <span></span>
                                <i class="bi @producto.Icono"></i>
                            </div>
                            <span class="catalog-card__type">@producto.Tipo</span>
                        </div>
                        <div class="catalog-card__body">
                            <span class="catalog-card__category">@producto.Categoria</span>
                            <h3>@producto.Nombre</h3>
                            @if (!string.IsNullOrWhiteSpace(producto.Detalle))
                            {
                                <p class="catalog-card__detail">@producto.Detalle</p>
                            }
                            <div class="catalog-card__meta">
                                @if (producto.FechaCompra.HasValue)
                                {
                                    <span><i class="bi bi-calendar3" aria-hidden="true"></i> @producto.FechaCompra.Value.ToDateTime(TimeOnly.MinValue).ToString("dd MMM yyyy", currencyCulture)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(producto.Estado))
                                {
                                    <span class="catalog-card__status"><i aria-hidden="true"></i>@producto.Estado</span>
                                }
                            </div>
                            <div class="catalog-card__footer">
                                <span>VALOR REGISTRADO</span>
                                @if (producto.Precio.HasValue)
                                {
                                    <strong>@producto.Precio.Value.ToString("C", currencyCulture)</strong>
                                }
                                else
                                {
                                    <strong class="catalog-card__no-price">Sin importe</strong>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
            <nav class="catalog-pagination" id="catalog-pagination" aria-label="Paginación del catálogo" hidden>
                <ul class="catalog-pagination__list" id="catalog-pagination-list"></ul>
            </nav>
            <div class="catalog-empty catalog-empty--filtered" id="catalog-no-results" hidden>
                <span class="catalog-empty__icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                <h3>No encontramos coincidencias.</h3>
                <p>Prueba con otro nombre, categoría o tipo de producto.</p>
            </div>
            <div class="modal fade catalog-detail-modal" id="catalog-detail-modal" tabindex="-1" aria-labelledby="catalog-detail-title" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div>
                                <span class="catalog-detail-modal__kicker"><i class="bi bi-info-circle" aria-hidden="true"></i> FICHA DEL PRODUCTO</span>
                                <h2 class="modal-title" id="catalog-detail-title"></h2>
                            </div>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <div class="catalog-detail-modal__layout">
                                <div class="catalog-detail-modal__visual">
                                    <img id="catalog-detail-image" alt="" hidden />
                                    <div class="catalog-detail-modal__placeholder" id="catalog-detail-placeholder" aria-hidden="true">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                </div>
                                <div class="catalog-detail-modal__information">
                                    <span class="catalog-detail-modal__type" id="catalog-detail-type"></span>
                                    <dl class="catalog-detail-modal__list" id="catalog-detail-list"></dl>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>
</div>

@section Scripts {
    @if (Model.Productos.Count > 0)
    {
        <script>
            (() => {
                const searchInput = document.getElementById("catalog-search");
                const filterButtons = document.querySelectorAll("[data-catalog-filter]");
                const items = Array.from(document.querySelectorAll("[data-catalog-item]"));
                const resultsLabel = document.getElementById("catalog-results");
                const noResults = document.getElementById("catalog-no-results");
                const pagination = document.getElementById("catalog-pagination");
                const paginationList = document.getElementById("catalog-pagination-list");
                const detailModal = document.getElementById("catalog-detail-modal");
                const detailTitle = document.getElementById("catalog-detail-title");
                const detailType = document.getElementById("catalog-detail-type");
                const detailImage = document.getElementById("catalog-detail-image");
                const detailPlaceholder = document.getElementById("catalog-detail-placeholder");
                const detailList = document.getElementById("catalog-detail-list");
                const pageSize = 9;
                let activeFilter = "TODOS";
                let currentPage = 1;

                const showProductDetails = (item) => {
                    const product = item.dataset;
                    detailTitle.textContent = item.querySelector(".catalog-card__body h3").textContent.trim();
                    detailType.textContent = product.type;
                    detailList.replaceChildren();

                    const productFields = [
                        ["Categoría", product.category],
                        ["Marca", product.brand],
                        ["Modelo", product.model],
                        ["Plataforma", product.platform],
                        ["Género", product.genre],
                        ["Estado", product.status],
                        ["Fecha de compra", product.purchaseDate],
                        ["Valor registrado", product.price]
                    ];

                    productFields.forEach(([label, value]) => {
                        if (!value) {
                            return;
                        }

                        const row = document.createElement("div");
                        const term = document.createElement("dt");
                        const description = document.createElement("dd");
                        row.className = "catalog-detail-modal__field";
                        term.textContent = label;
                        description.textContent = value;
                        row.append(term, description);
                        detailList.append(row);
                    });

                    const icon = item.querySelector(".catalog-card__placeholder i");
                    detailPlaceholder.replaceChildren();
                    if (icon) {
                        const placeholderIcon = document.createElement("i");
                        placeholderIcon.className = icon.className;
                        detailPlaceholder.append(placeholderIcon);
                    }

                    detailImage.hidden = true;
                    detailImage.removeAttribute("src");
                    detailPlaceholder.hidden = false;
                    detailImage.alt = detailTitle.textContent;
                    if (product.image) {
                        detailImage.onerror = () => {
                            detailImage.hidden = true;
                            detailPlaceholder.hidden = false;
                        };
                        detailImage.onload = () => {
                            detailImage.hidden = false;
                            detailPlaceholder.hidden = true;
                        };
                        detailImage.src = product.image;
                    }

                    bootstrap.Modal.getOrCreateInstance(detailModal).show();
                };

                items.forEach((item) => {
                    item.addEventListener("click", () => showProductDetails(item));
                    item.addEventListener("keydown", (event) => {
                        if (event.key === "Enter" || event.key === " ") {
                            event.preventDefault();
                            showProductDetails(item);
                        }
                    });
                });

                document.querySelectorAll(".catalog-card__visual img").forEach((image) => {
                    image.addEventListener("error", () => {
                        image.hidden = true;
                        const placeholder = image.nextElementSibling;
                        if (placeholder) {
                            placeholder.hidden = false;
                        }
                    });
                });

                const createPageButton = (label, page, options = {}) => {
                    const item = document.createElement("li");
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "catalog-page-button";
                    button.textContent = label;
                    button.dataset.page = String(page);
                    button.setAttribute("aria-label", options.ariaLabel || `Ir a la página ${page}`);
                    if (options.current) {
                        button.setAttribute("aria-current", "page");
                    }
                    if (options.disabled) {
                        button.disabled = true;
                    }
                    item.append(button);
                    return item;
                };

                const renderPagination = (pageCount) => {
                    paginationList.replaceChildren();
                    pagination.hidden = pageCount <= 1;
                    if (pagination.hidden) {
                        return;
                    }

                    paginationList.append(createPageButton("‹", currentPage - 1, {
                        ariaLabel: "Página anterior",
                        disabled: currentPage === 1
                    }));

                    const pages = new Set([1, pageCount]);
                    for (let page = Math.max(1, currentPage - 1); page <= Math.min(pageCount, currentPage + 1); page += 1) {
                        pages.add(page);
                    }

                    let previousPage = 0;
                    [...pages].sort((first, second) => first - second).forEach((page) => {
                        if (previousPage && page - previousPage > 1) {
                            const ellipsis = document.createElement("li");
                            ellipsis.className = "catalog-pagination__ellipsis";
                            ellipsis.textContent = "…";
                            paginationList.append(ellipsis);
                        }

                        paginationList.append(createPageButton(String(page), page, {
                            current: page === currentPage
                        }));
                        previousPage = page;
                    });

                    paginationList.append(createPageButton("›", currentPage + 1, {
                        ariaLabel: "Página siguiente",
                        disabled: currentPage === pageCount
                    }));
                };

                const updateCatalog = (focusPage = false) => {
                    const query = searchInput.value.trim().toLocaleLowerCase("es");
                    const matchingItems = items.filter((item) => {
                        const matchesType = activeFilter === "TODOS" || item.dataset.type === activeFilter;
                        const matchesQuery = (item.dataset.search || "").toLocaleLowerCase("es").includes(query);
                        return matchesType && matchesQuery;
                    });

                    const pageCount = Math.ceil(matchingItems.length / pageSize);
                    currentPage = Math.min(currentPage, Math.max(pageCount, 1));
                    const firstItemIndex = (currentPage - 1) * pageSize;
                    const visibleItems = new Set(matchingItems.slice(firstItemIndex, firstItemIndex + pageSize));

                    items.forEach((item) => {
                        item.hidden = !visibleItems.has(item);
                    });

                    noResults.hidden = matchingItems.length > 0;
                    resultsLabel.textContent = matchingItems.length === 0
                        ? "0 productos"
                        : `Mostrando ${firstItemIndex + 1}–${Math.min(firstItemIndex + pageSize, matchingItems.length)} de ${matchingItems.length} productos`;
                    renderPagination(pageCount);

                    if (focusPage) {
                        paginationList.querySelector(`[data-page="${currentPage}"]`)?.focus();
                        document.getElementById("collection-title").scrollIntoView({
                            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
                            block: "start"
                        });
                    }
                };

                paginationList.addEventListener("click", (event) => {
                    const button = event.target.closest("button[data-page]");
                    if (!button || button.disabled) {
                        return;
                    }

                    currentPage = Number(button.dataset.page);
                    updateCatalog(true);
                });

                filterButtons.forEach((button) => {
                    button.addEventListener("click", () => {
                        activeFilter = button.dataset.catalogFilter;
                        currentPage = 1;
                        filterButtons.forEach((filter) => {
                            const isActive = filter === button;
                            filter.classList.toggle("is-active", isActive);
                            filter.setAttribute("aria-pressed", String(isActive));
                        });
                        updateCatalog();
                    });
                });

                searchInput.addEventListener("input", () => {
                    currentPage = 1;
                    updateCatalog();
                });

                updateCatalog();
            })();
        </script>
    }
}

     aria-labelledby="catalog-update-success-title" aria-describedby="catalog-update-success-message" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body">
                <span class="catalog-update-modal__icon"><i class="bi bi-check2" aria-hidden="true"></i></span>
                <span class="catalog-update-modal__eyebrow">CAMBIOS GUARDADOS</span>
                <h2 id="catalog-update-success-title">¡Actualización exitosa!</h2>
                <p id="catalog-update-success-message" aria-live="polite">Los datos del producto se actualizaron correctamente.</p>
                <button type="button" class="btn catalog-update-modal__button" data-bs-dismiss="modal">
                    <i class="bi bi-check-lg me-2" aria-hidden="true"></i>Continuar
                </button>
